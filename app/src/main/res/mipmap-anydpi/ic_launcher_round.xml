<?xml version="1.0" encoding="utf-8"?>
<!--
    自适应图标（API 26+，本应用 minSdk 就是 26，生效的一直是这一份）。
    由 tools/build_icon.py 生成，别手改 —— 重新跑一次就覆盖了。

    前景层是**铺满**的：源图自己就带圆角，那就是它的造型 ——
    按内容裁紧成正方形后直接映射到 108dp 画布，透明处填白。
    再缩进安全圆内的话，托盘里会变成「一块白方 + 中间一个小渐变方」。

    角落填白是刻意的：方形托盘的角落否则会透出托盘底色，
    而这个图标要出现在桌面、设置列表、最近任务好几处。

    单色层取的是白 R 的字形，不是整块方形的轮廓 —— 给轮廓的话
    主题图标会变成一个没有任何特征的色块，一排里认不出谁是谁。

    单色层给 Android 13+ 的「按壁纸取色」用，系统只取它的 alpha。
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_art" />
    <monochrome android:drawable="@mipmap/ic_launcher_mono" />
</adaptive-icon>
