<?xml version="1.0" encoding="utf-8"?>
<!--
    无障碍服务的配置。

    只声明「截屏」一项能力：不订阅事件、不读窗口内容。
    服务对 App 的唯一作用就是借到系统那个 takeScreenshot。

    canTakeScreenshot 绝不能省。少了它，调用截屏时系统会直接抛
    SecurityException（"Services don't have the capability of taking the screenshot"），
    不是返回失败码。这是 API 30 起的硬要求。

    accessibilityEventTypes 声明了 typeWindowStateChanged，但服务里什么都不做 ——
    配置必须至少有一个事件类型，否则系统不允许服务被启用。
    通知超时设成 1 秒，避免窗口频繁变化时反复唤醒我们（我们并不关心这些事件）。
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:canTakeScreenshot="true"
    android:description="@string/a11y_shot_description"
    android:notificationTimeout="1000"
    android:summary="@string/a11y_shot_summary" />
